# Build outputs: the cart and its engine copy are produced by build.sh from
# the wasmcart-lua checkout, so they are reproducible rather than sources.
main.wasm
*.wasc
app/assets.index

# Test artefacts
test/shots/

# Test-mode marker: a build flag, never committed (a committed one would
# ship a cart that runs the unit suite instead of the game).
app/testmode

# Gate-mode marker: boots the generated map instead of the campaign.
app/opengarden
# Build-time level override for gates (see main.lua); never committed.
app/startlevel
# Suite logs, whatever they are named. This was `test/suite.log` exactly,
# so a run written to any other name (suite08.log, suite-final.log) showed
# up as an untracked file waiting to be committed by accident.
test/*.log

# SAVE DATA IS THE PLAYER'S, not the project's. The playtest window writes
# a rolling checkpoint next to the cart (romdev >= 0.129.0 does this for
# wasmcart carts, as `<cart>.playtest-autosave.sav`), and a rescued save
# lands here too. Both are one person's colony -- never a repo artefact.
*.sav

# macOS finder droppings
.DS_Store
